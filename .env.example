# Port (defaults to 3000 locally)
PORT=3000

# ------------------------------------------
# Free Supabase Cloud Database Configuration
# 1. Sign up at https://supabase.com
# 2. Create a new free project
# 3. Go to Project Settings -> API to copy these:
# ------------------------------------------
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-key

# ------------------------------------------
# Telegram Instant Message Forwarding
# 1. Message @BotFather on Telegram -> /newbot -> get TELEGRAM_BOT_TOKEN
# 2. Message @userinfobot or @myidbot on Telegram -> get your TELEGRAM_CHAT_ID
# ------------------------------------------
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_CHAT_ID=123456789

