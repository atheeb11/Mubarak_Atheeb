<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 500" width="100%" height="100%">
  <defs>
    <linearGradient id="bgGrad4" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#1e1b4b" />
      <stop offset="50%" stop-color="#312e81" />
      <stop offset="100%" stop-color="#4c1d95" />
    </linearGradient>
    <linearGradient id="violetGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#c084fc" />
      <stop offset="100%" stop-color="#60a5fa" />
    </linearGradient>
  </defs>
  <rect width="800" height="500" fill="url(#bgGrad4)" />
  <rect x="60" y="50" width="680" height="400" rx="16" fill="#0f0e2b" stroke="rgba(192, 132, 252, 0.3)" stroke-width="2" />
  <circle cx="90" cy="75" r="6" fill="#ef4444" />
  <circle cx="110" cy="75" r="6" fill="#eab308" />
  <circle cx="130" cy="75" r="6" fill="#22c55e" />
  <text x="100" y="150" fill="#ffffff" font-family="'Segoe UI', sans-serif" font-weight="800" font-size="30">Harvest Business Media Hub</text>
  <text x="100" y="185" fill="url(#violetGrad)" font-family="'Segoe UI', sans-serif" font-weight="600" font-size="16">BRANDING • MULTI-PLATFORM SOCIAL ARCHITECTURE • ENGAGEMENT</text>
  <!-- Social feed mock -->
  <rect x="140" y="230" width="150" height="150" rx="12" fill="#1e1b4b" stroke="#6366f1" stroke-width="2" />
  <circle cx="215" cy="280" r="28" fill="#818cf8" />
  <rect x="160" y="330" width="110" height="10" rx="4" fill="#a5b4fc" />
  <rect x="175" y="350" width="80" height="8" rx="4" fill="#6366f1" />
  <!-- Growth card -->
  <rect x="330" y="230" width="350" height="150" rx="12" fill="#1e1b4b" stroke="#a855f7" stroke-width="1.5" />
  <text x="360" y="275" fill="#f3e8ff" font-family="'Segoe UI', sans-serif" font-weight="bold" font-size="18">Audience & Engagement Growth</text>
  <text x="360" y="310" fill="#34d399" font-family="'Segoe UI', sans-serif" font-weight="bold" font-size="28">+240%</text>
  <text x="470" y="310" fill="#94a3b8" font-family="'Segoe UI', sans-serif" font-size="13">Impressions reach per quarter</text>
  <line x1="360" y1="345" x2="650" y2="345" stroke="#4338ca" stroke-width="6" stroke-linecap="round" />
  <line x1="360" y1="345" x2="580" y2="345" stroke="#a855f7" stroke-width="6" stroke-linecap="round" />
</svg>

